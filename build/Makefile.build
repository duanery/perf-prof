PHONY := __build
__build:

ifeq ($(V),1)
  quiet =
  Q =
else
  quiet=quiet_
  Q=@
endif

ifneq ($(findstring s,$(firstword $(MAKEFLAGS))),)
  quiet=silent_
endif

build-dir := $(srctree)/build

# Define $(fixdep) for dep-cmd function
ifeq ($(wildcard $(OUTPUT)/fixdep),)
  fixdep := $(build-dir)/fixdep
else
  fixdep := $(OUTPUT)/fixdep
endif

# Generic definitions
include $(build-dir)/Build.include
include $(srctree)/scripts/Makefile.include

# do not force detected configuration
-include $(OUTPUT).config-detected

# Init all relevant variables used in build files so
# 1) they have correct type
# 2) they do not inherit any value from the environment
subdir-y     :=
obj-y        :=
subdir-y     :=
subdir-obj-y :=

# Build definitions
# Prefer 'Build.bin' over 'Build' so the top-level manifest can avoid the
# case-insensitive collision with the 'build/' directory on macOS / Windows
# filesystems. Subdirectories keep using 'Build'.
build-file := $(or $(wildcard $(dir)/Build.bin),$(dir)/Build)
-include $(build-file)

quiet_cmd_flex  = FLEX    $@
quiet_cmd_bison = BISON   $@
quiet_cmd_test  = TEST    $@

# Create directory unless it exists
quiet_cmd_mkdir = MKDIR   $(dir $@)
      cmd_mkdir = mkdir -p $(dir $@)
     rule_mkdir = $(if $(wildcard $(dir $@)),,@$(call echo-cmd,mkdir) $(cmd_mkdir))

quiet_cmd_clean = CLEAN   $(dir)
      cmd_clean = $(RM) -f $(2) 
	 _clean = @set -e; $(echo-cmd) $(cmd_$(1))
# Compile command
quiet_cmd_cc_o_c = CC      $@
      cmd_cc_o_c = $(CC) $(c_flags) -c -o $@ $<

quiet_cmd_host_cc_o_c = HOSTCC  $@
      cmd_host_cc_o_c = $(HOSTCC) $(host_c_flags) -c -o $@ $<

quiet_cmd_cxx_o_c = CXX     $@
      cmd_cxx_o_c = $(CXX) $(cxx_flags) -c -o $@ $<

quiet_cmd_cpp_i_c = CPP     $@
      cmd_cpp_i_c = $(CC) $(c_flags) -E -o $@ $<

quiet_cmd_cc_s_c = AS      $@
      cmd_cc_s_c = $(CC) $(c_flags) -S -o $@ $<

quiet_cmd_bpf_o_c = BPF     $@
      cmd_bpf_o_c = $(CLANG) -Wp,-MD,$(depfile) -Wp,-MT,$@ $(INCLUDES) \
                    -g -O2 -target bpf -D__TARGET_ARCH_$(SRCARCH) -c -o $@ $< \
                    && $(LLVM_STRIP) -g $@

quiet_cmd_bpf_skel_h = GEN-SKL $@
      cmd_bpf_skel_h = $(BPFTOOL) gen skeleton $< > $@

quiet_cmd_vmlinux_h = VMLINUX $@
      cmd_vmlinux_h = $(BPFTOOL) btf dump file $< format c > $@

quiet_cmd_gen = GEN     $@

# Link agregate command
# If there's nothing to link, create empty $@ object.
quiet_cmd_ld_multi = LD      $@
      cmd_ld_multi = $(if $(strip $(filter %.o,$(obj-y))),\
                     $(LD) -r -o $@  $(filter $(filter %.o,$(obj-y)),$^),rm -f $@; $(AR) rcs $@)

quiet_cmd_host_ld_multi = HOSTLD  $@
      cmd_host_ld_multi = $(if $(strip $(filter %.o,$(obj-y))),\
                          $(HOSTLD) -r -o $@  $(filter $(filter %.o,$(obj-y)),$^),rm -f $@; $(HOSTAR) rcs $@)

ifneq ($(filter $(obj),$(hostprogs)),)
  host = host_
endif

# Build rules
$(OUTPUT)%.o: %.c FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,$(host)cc_o_c)

$(OUTPUT)%.o: %.cpp FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,cxx_o_c)

$(OUTPUT)%.o: %.S FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,$(host)cc_o_c)

$(OUTPUT)%.i: %.c FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,cpp_i_c)

$(OUTPUT)%.s: %.S FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,cpp_i_c)

$(OUTPUT)%.s: %.c FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,cc_s_c)

# bison and flex files are generated in the OUTPUT directory
# so it needs a separate rule to depend on them properly
$(OUTPUT)%-bison.o: $(OUTPUT)%-bison.c FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,$(host)cc_o_c)

$(OUTPUT)%-flex.o: $(OUTPUT)%-flex.c FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,$(host)cc_o_c)

$(dir)/vmlinux.h: /sys/kernel/btf/vmlinux FORCE
	$(call rule_mkdir)
	$(call if_changed,vmlinux_h)

# Gather build data:
#   obj-y        - list of build objects
#   subdir-y     - list of directories to nest
#   subdir-obj-y - list of directories objects 'dir/$(obj)-in.o'
obj-y        := $($(obj)-y)
subdir-y     := $(patsubst %/,%,$(filter %/, $(obj-y)))
obj-y        := $(patsubst %/, %/$(obj)-in.o, $(obj-y))
subdir-obj-y := $(filter %/$(obj)-in.o, $(obj-y))

# '$(OUTPUT)/dir' prefix to all objects
objprefix    := $(subst ./,,$(OUTPUT)$(dir)/)
obj-y        := $(addprefix $(objprefix),$(obj-y))
subdir-obj-y := $(addprefix $(objprefix),$(subdir-obj-y))

# Final '$(obj)-in.o' object
in-target := $(objprefix)$(obj)-in.o
skel-target := $(filter %.skel.h,$(obj-y))
# A .bpf.o normally comes from a declared .skel.h, but Makefile.config's BPF
# slot check builds src/bpf-skel/slot_check.bpf.o as a direct goal and lists
# it in no Build file. Pick it up from $(MAKECMDGOALS) as well, or the static
# pattern rule below would not cover it and it would fall through to the
# generic '%.o: %.c' rule -- compiled by $(CC) instead of $(CLANG), failing on
# '#include "vmlinux.h"' and silently degrading the probe to its fallback.
bpf-target := $(sort $(patsubst %.skel.h, %.bpf.o, $(skel-target)) \
                     $(filter %.bpf.o,$(MAKECMDGOALS)))
vmlinux-target := $(if $(bpf-target), $(dir)/vmlinux.h)

# Static pattern rules, so they only ever apply to the .bpf.o / .skel.h that
# this directory's Build file declares.
#
# They used to be plain pattern rules ('$(OUTPUT)%.skel.h: %.bpf.o'), which
# are global: make tries them against any file it has to evaluate, whether or
# not that file is in this directory's $(obj-y). And 'include $(cmd_files)'
# below pulls in fixdep's header lists, one of which reads
#
#     src/bpf_kvm_exit.o: ... src/bpf-skel/kvm_exit.skel.h ...
#
# so in the dir=./src instance that .skel.h became a prerequisite make had to
# evaluate. It has no explicit rule there, the pattern matched ('%' spans '/',
# giving %=src/bpf-skel/kvm_exit), and that instance rebuilt the skeleton
# itself instead of leaving it to the sub-make -- every BPF/GEN-SKL ran twice.
# The chained $(dir)/vmlinux.h prerequisite was resolved against the *parent's*
# $(dir), so it also dumped a stray src/vmlinux.h that nothing includes.
#
# With the static form, skel-target is empty in dir=./src, no rule matches the
# skeleton, and make treats it as a plain existing file: mtime only.
$(bpf-target): $(objprefix)%.bpf.o: $(dir)/%.bpf.c $(vmlinux-target) FORCE
	$(call rule_mkdir)
	$(call if_changed_dep,bpf_o_c)

$(skel-target): $(objprefix)%.skel.h: $(objprefix)%.bpf.o FORCE
	$(call rule_mkdir)
	$(call if_changed,bpf_skel_h)

# A generated skeleton header has no dependency edge to the objects that
# #include it -- being listed earlier in the same Build file only happens
# to work under -j1. Order every compile here after the skeletons of this
# directory and after every subdirectory, which may generate headers too.
#
# Order-only ('|') on purpose: a normal prerequisite would land in $?, which
# if_changed_dep tests, and rebuild every object whenever a skeleton is
# regenerated. Ordering is all that is needed -- once the header exists,
# fixdep has recorded the real content dependency in the .cmd file.
$(filter-out $(subdir-obj-y),$(filter %.o,$(obj-y))): | $(skel-target) $(subdir-y)

# $(bpf-target) and $(vmlinux-target) are not intermediate file
.PRECIOUS: $(bpf-target) $(vmlinux-target)

PHONY += $(subdir-y)

$(subdir-y):
	$(Q)$(MAKE) -f $(build-dir)/Makefile.build dir=$(dir)/$@ obj=$(obj)

$(sort $(subdir-obj-y)): $(subdir-y) ;

$(in-target): $(obj-y) FORCE
	$(call rule_mkdir)
	$(call if_changed,$(host)ld_multi)

__build: $(in-target)
	@:

subdir-clean-y := $(addsuffix -clean,$(subdir-y))
$(subdir-clean-y):
	$(Q)$(MAKE) -f $(build-dir)/Makefile.build dir=$(dir)/$(patsubst %-clean,%,$(notdir $@)) obj=$(obj) clean

clean: $(subdir-clean-y)
	$(call _clean,clean,$(in-target) $(bpf-target) $(vmlinux-target) $(obj-y) $(objprefix)*.o $(objprefix).*.cmd $(objprefix).*.d)

PHONY += FORCE
FORCE:

# Include all cmd files to get all the dependency rules
# for all objects included
targets   := $(wildcard $(sort $(obj-y) $(in-target) $(bpf-target) $(vmlinux-target) $(MAKECMDGOALS)))
cmd_files := $(wildcard $(foreach f,$(targets),$(dir $(f)).$(notdir $(f)).cmd))

ifneq ($(cmd_files),)
  include $(cmd_files)
endif

.PHONY: $(PHONY)
